# ========================================================
# Langflow Agents - Environment Template
# Copy to .env and fill in. NEVER commit .env
# ========================================================

# Langflow login (same defaults as the n8n sibling repo)
LANGFLOW_SUPERUSER=admin@example.org
LANGFLOW_SUPERUSER_PASSWORD=admin

# Gemini API key (exposed to flows as global variable GOOGLE_API_KEY)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenShift only: stable encryption key for stored credentials (openssl rand -hex 32)
LANGFLOW_SECRET_KEY=generate_with_openssl_rand_hex_32
