# ========================================================
# Langflow Agents - Environment Template
# Copy to .env and fill in. NEVER commit .env
# ========================================================

# Langflow login (same defaults as the n8n sibling repo)
LANGFLOW_SUPERUSER=admin@example.org
LANGFLOW_SUPERUSER_PASSWORD=admin

# Gemini API key (exposed to flows as global variable GOOGLE_API_KEY)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenShift only: stable encryption key for stored credentials. Generate once with:
#   python3 -c "from secrets import token_urlsafe; print(token_urlsafe(32))"
# Never change it afterwards, otherwise credentials stored in Langflow become unreadable.
# Also use a strong LANGFLOW_SUPERUSER_PASSWORD above: the OpenShift route is public.
LANGFLOW_SECRET_KEY=your_secret_key_here
